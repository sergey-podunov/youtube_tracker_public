apiVersion: v1
kind: Secret
metadata:
  name: google-api-key
type: Opaque
data:
  api-key: <base64-encoded-api-key>

# To create this secret from command line:
# kubectl create secret generic google-api-key --from-literal=api-key=YOUR_API_KEY_HERE

# To create/update the secret in a specific namespace:
# kubectl create secret generic google-api-key --from-literal=api-key=YOUR_API_KEY_HERE -n test

# To update the secret (create or replace):
# kubectl create secret generic google-api-key --from-literal=api-key=YOUR_API_KEY_HERE --dry-run=client -o yaml | kubectl apply -f -
