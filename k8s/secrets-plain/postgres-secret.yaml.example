apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret-config
type: Opaque
data:
  # PostgreSQL admin user (used by postgres container)
  ps_user-pass: encoded_password

  # Application user (used by youtube-tracker app and Atlas for password management)
  youtube_tracker_app-pass: encoded_password
  youtube_tracker_app-url: encoded_full_db_url

  # Atlas migrations user (used by AtlasSchema operator and pg init script)
  atlas_app-pass: encoded_password
  atlas-url: encoded_full_db_url

  # Dev user: read-only access for production data inspection
  dev_user-pass: encoded_password

# echo -n 'Password' | base64
# echo -n 'postgres://user_app:Password@postgres:5432/ps_db?sslmode=disable' | base64