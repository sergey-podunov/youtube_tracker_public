apiVersion: v1
kind: Secret
metadata:
  name: notify-secrets
type: Opaque
data:
  # Base64-encoded values. Use: echo -n "value" | base64
  TELEGRAM_TOKEN: base64_telegram_bot_token
  TELEGRAM_CHAT_ID: base64_numeric_chat_id
  SLACK_WEBHOOK_URL: base64_slack_webhook_url
  SLACK_BOT_TOKEN: base64_slack_bot_token
  SLACK_DM_USER_ID: base64_slack_user_id

# Examples:
# echo -n "123456789:AA..." | base64

